#!/bin/bash
set -euo pipefail

# The blob is a static linux/amd64 build of the Shout! Go server, so there is
# nothing to compile on the stemcell.
install -d -m 0755 "${BOSH_INSTALL_TARGET}/bin"
install -m 0755 shout/shout-linux-amd64 "${BOSH_INSTALL_TARGET}/bin/shout"

# Fail the compilation if the binary cannot run on this stemcell.
"${BOSH_INSTALL_TARGET}/bin/shout" -version
